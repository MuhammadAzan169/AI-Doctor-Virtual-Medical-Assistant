# ── AI Doctor — repository root ──────────────────────────────────────────
# Layout:  Backend/  Frontend/  README.md  app.py
# Backend/ and Frontend/ each carry their own .gitignore as well.

# Secrets — never commit. Only the .env.example templates are tracked.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
build/
dist/
sdist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Backend runtime output (uploads, OCR results, generated PDFs)
Backend/var/

# Frontend build artefact — generated by build.mjs / app.py
Frontend/js/config.js
node_modules/
.vercel/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# IDE / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
