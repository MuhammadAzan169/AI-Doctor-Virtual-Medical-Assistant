# ── AI Doctor — Backend Environment ───────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

ENVIRONMENT=development            # development | production
PORT=8000
LOG_LEVEL=INFO

# Comma-separated allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend.vercel.app

# ── LLM (OpenAI-compatible, e.g. OpenRouter) ──────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-3-4b-it:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_API_KEY=your-api-key-here
# Optional: ordered model fallback chain (overrides LLM_MODEL when set)
# OPENROUTER_MODEL_1=openai/gpt-oss-20b:free
# OPENROUTER_MODEL_2=google/gemma-3-4b-it:free
# Optional rotation keys, tried in order on rate-limit/auth errors. These are
# read from the process environment (Render) AND from this .env file (local).
# OPENROUTER_API_KEY1=
# OPENROUTER_API_KEY2=

# ── Consultation ──────────────────────────────────────────────────────
MAX_QUESTIONS=8
MAX_MESSAGE_LENGTH=5000
MAX_UPLOAD_SIZE_MB=10
SESSION_TTL_SECONDS=3600

# ── Optional ML features (heavy — opt-in) ─────────────────────────────
# Each requires the extra deps in requirements-local.txt and a larger instance.
# Locally, app.py enables each one automatically when its package is installed.
ENABLE_FRACTURE=false              # TensorFlow ResNet50 X-ray models (~376 MB)
ENABLE_OCR=false                   # PaddleOCR lab-report reading
ENABLE_VOICE=false                 # Whisper speech-to-text (~1.5 GB)
WHISPER_MODEL_SIZE=medium
# MODELS_DIR=fracture_models        # path to .h5 models (relative to backend/)

# ── Runtime (writable) directory ──────────────────────────────────────
RUNTIME_DIR=var
